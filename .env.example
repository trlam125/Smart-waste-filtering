# Hugging Face model used for zero-shot image classification.
WASTE_MODEL=openai/clip-vit-base-patch32

# Mark a result uncertain if the highest relative category score is below this value.
# The predicted category is preserved instead of being changed to "other".
UNKNOWN_THRESHOLD=0.24

# Also mark a result uncertain when Top-1 and Top-2 are too close.
# Example: 0.05 means a gap smaller than 5 percentage points is ambiguous.
UNCERTAINTY_MARGIN=0.05

# Two-stage focus crops. Stage 1 uses shape/object prompts to find the most
# useful view and orientation before Stage 2 scores material/category prompts.
CENTER_CROP_ENABLED=true
CENTER_CROP_WIDTH_RATIO=0.72
CENTER_CROP_HEIGHT_RATIO=0.86
WIDE_CROP_ENABLED=true
WIDE_CROP_WIDTH_RATIO=0.96
WIDE_CROP_HEIGHT_RATIO=0.62
SECONDARY_CROP_WIDTH_RATIO=0.88
SECONDARY_CROP_HEIGHT_RATIO=0.74

# Evaluate centered views at 0/90/180/270 degrees when useful. This handles
# phone photos whose pixels are sideways even when EXIF orientation is missing.
ROTATION_ENSEMBLE_ENABLED=true
OBJECT_VIEW_TOP_K=2

# Pool the strongest prompt matches inside each stage/category.
OBJECT_PROMPT_TOP_K=2
PROMPT_SCORE_TOP_K=2

# Fuse shape/object evidence with material evidence. Shape gets a slight
# majority so a printed sleeve around a bottle does not look like paper waste.
OBJECT_PRIOR_WEIGHT=0.55
MATERIAL_PRIMARY_WEIGHT=0.60
MATERIAL_SECONDARY_WEIGHT=0.25
MATERIAL_FULL_WEIGHT=0.15

# If paper conflicts with hard/soft plastic, or hard plastic conflicts with
# flexible plastic, use object-shape evidence to redistribute only the relevant
# top-two pair. Variable names are kept for backward compatibility.
PAPER_PLASTIC_GUARD_ENABLED=true
PAPER_PLASTIC_OBJECT_WEIGHT=0.72
PAPER_PLASTIC_OBJECT_MARGIN=0.08

# Mark a cross-stage disagreement uncertain when the final top-1/top-2 gap is
# still small after fusion.
STAGE_DISAGREEMENT_MARGIN=0.08

# Retry a transient model-load failure after this many seconds.
MODEL_RETRY_SECONDS=30

# Warm the AI model shortly after server startup to reduce first-scan latency.
PRELOAD_MODEL=true

# Downscale decoded images before CLIP preprocessing to reduce CPU/RAM use.
CLASSIFIER_IMAGE_MAX_DIMENSION=1024

# Reject images whose decoded dimensions exceed this pixel count.
MAX_IMAGE_PIXELS=20000000

# SQLite file location.
DATABASE_PATH=data/waste_scanner.db
# DELETE giu du lieu commit trong file .db, an toan hon khi copy/ZIP du an.
SQLITE_JOURNAL_MODE=DELETE

# Wait this many milliseconds for short SQLite lock contention before failing.
SQLITE_BUSY_TIMEOUT_MS=5000

# Local FastAPI port used by launcher.py.
PORT=8000

# Get this value from the ngrok dashboard. Never commit your real token.
NGROK_AUTHTOKEN=

# Optional reserved/static ngrok domain. Leave blank for an automatic URL.
NGROK_DOMAIN=

# Optional HTTP Basic Auth in the form username:password.
# Example: NGROK_BASIC_AUTH=demo:change-me-now
NGROK_BASIC_AUTH=

# Learn from explicit user feedback. Memory is shared across all devices using this database.
FEEDBACK_LEARNING_ENABLED=true
# Maximum confirmed/corrected examples read for one scan.
LEARNING_MAX_EXAMPLES=500
# Number of nearest feedback examples allowed to influence one result.
LEARNING_TOP_K=5
# Minimum cosine similarity for real CLIP embeddings.
LEARNING_MIN_SIMILARITY=0.84
# Stricter threshold used only if CLIP embedding extraction falls back to score fingerprints.
LEARNING_SCORE_MIN_SIMILARITY=0.96
# Maximum fraction of the final score that feedback memory may contribute.
LEARNING_MAX_WEIGHT=0.60
# Trust factor for a single matching feedback example; repeated consistent examples approach 1.0.
LEARNING_SINGLE_EXAMPLE_FACTOR=0.78
# Minimum memory weight allowed to override object/material stage disagreement.
LEARNING_DISAGREEMENT_OVERRIDE_WEIGHT=0.20

# Thumbnail lich su de nhan ra vat the khi sua nhan cu.
# De trong de tu dong tach thu muc theo DATABASE_PATH; chi dat khi can duong dan rieng.
SCAN_THUMBNAIL_DIR=
# Legacy data/scans/scan_<id>.jpg was shared across databases and is ambiguous.
# Keep false unless you are intentionally migrating one trusted old database.
MIGRATE_LEGACY_THUMBNAILS=false
THUMBNAIL_MAX_DIMENSION=480
THUMBNAIL_JPEG_QUALITY=80
