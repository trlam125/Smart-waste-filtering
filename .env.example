# Trained supervised checkpoint. Relative paths are resolved from project root.
WASTE_MODEL_CHECKPOINT=models/best_model.pt

# auto = CUDA if available, then Apple MPS, otherwise CPU.
WASTE_DEVICE=auto

# Mark a result uncertain if top-1 softmax confidence is below this value.
# Tune these after inspecting validation/test behavior for your trained checkpoint.
UNKNOWN_THRESHOLD=0.45

# Also mark uncertain when top-1 and top-2 are too close.
UNCERTAINTY_MARGIN=0.10

# Retry loading a missing/broken checkpoint after this many seconds.
MODEL_RETRY_SECONDS=10

# Warm the trained model shortly after server startup.
PRELOAD_MODEL=true

# Downscale decoded uploads before model preprocessing to reduce CPU/RAM use.
CLASSIFIER_IMAGE_MAX_DIMENSION=1024
MAX_IMAGE_PIXELS=20000000

# SQLite
DATABASE_PATH=data/waste_scanner.db
SQLITE_JOURNAL_MODE=DELETE
SQLITE_BUSY_TIMEOUT_MS=5000

# Local server
PORT=8000

# Required for deleting one history item or clearing all shared history.
# Put the real secret in .env; leave this example blank.
HISTORY_DELETE_PASSWORD=

# ngrok (optional)
NGROK_AUTHTOKEN=
NGROK_DOMAIN=
NGROK_BASIC_AUTH=

# Feedback learning. Semantic feature vectors are namespaced by checkpoint hash,
# so feedback from an old model is not mixed with a newly trained model.
FEEDBACK_LEARNING_ENABLED=true
# Must be at least 11 so every learnable class keeps at least one memory slot.
LEARNING_MAX_EXAMPLES=500
LEARNING_TOP_K=5
LEARNING_MIN_SIMILARITY=0.84
LEARNING_MAX_WEIGHT=0.60
LEARNING_SINGLE_EXAMPLE_FACTOR=0.78
# Chỉ cho bộ nhớ học gỡ trạng thái "chưa chắc chắn" khi có đủ bằng chứng đồng thuận.
LEARNING_CERTAINTY_MIN_EXAMPLES=3
LEARNING_CERTAINTY_MIN_AGREEMENT=0.75
LEARNING_CERTAINTY_MIN_SIMILARITY=0.92

# History thumbnails
SCAN_THUMBNAIL_DIR=
THUMBNAIL_MAX_DIMENSION=480
THUMBNAIL_JPEG_QUALITY=80

# Real-world dataset collection. Each saved scan is staged, then only moved into
# a labeled class folder after the user confirms/corrects it through feedback.
DATASET_COLLECTION_ENABLED=true
# Blank = <DATABASE_PATH parent>/collected. Set an absolute Drive path on Colab
# if you run the app from /content but want confirmed samples to persist.
COLLECTED_DATA_DIR=
COLLECTED_IMAGE_MAX_DIMENSION=1600
COLLECTED_JPEG_QUALITY=92
