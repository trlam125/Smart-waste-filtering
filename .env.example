# ============================================================
# SMART WASTE SCANNER - ENVIRONMENT CONFIGURATION
# ============================================================


# ============================================================
# CLASSIFIER MODEL
# ============================================================

# Trained supervised classifier checkpoint
WASTE_MODEL_CHECKPOINT=models/best_model.pt

# auto = CUDA if available, Apple MPS if available, otherwise CPU
WASTE_DEVICE=auto


# ============================================================
# YOLO OBJECT DETECTOR
# ============================================================

# YOLO detector checkpoint
WASTE_DETECTOR_CHECKPOINT=models/best_detector.pt

# auto = CUDA if available, otherwise CPU
WASTE_DETECTOR_DEVICE=auto


# ------------------------------------------------------------
# MULTI-OBJECT DETECTION
# ------------------------------------------------------------

# Minimum YOLO confidence.
#
# Lower value = detect more objects, but may produce more false positives.
# Original: 0.45
# Previous test: 0.25
#
# 0.10 is intentionally low for diagnosing whether the detector
# is capable of finding multiple objects.
DETECTOR_CONFIDENCE=0.10


# Non-Maximum Suppression IoU threshold.
#
# Higher value allows more overlapping bounding boxes
# to survive NMS.
#
# Useful when multiple objects are close together.
DETECTOR_IOU=0.65


# YOLO inference image size.
#
# Larger size can improve detection of small objects.
#
# 640 = faster
# 960 = better for multi-object / small objects
DETECTOR_IMAGE_SIZE=960


# Maximum number of detected objects per image
DETECTOR_MAX_DETECTIONS=20


# Minimum bounding-box area relative to entire image.
#
# 0.001 = 0.1% of image area.
#
# Very small objects will still be accepted.
DETECTOR_MIN_BOX_AREA_RATIO=0.001


# ------------------------------------------------------------
# MULTI-PASS RESCUE FOR MISSED OBJECTS
# ------------------------------------------------------------

# When the full-frame YOLO pass finds only a few objects, run
# extra overlapping crops along the image's long axis. This
# makes smaller or partially obscured objects larger at YOLO
# input resolution and improves multi-object recall.
DETECTOR_MULTIPASS_ENABLED=true

# Run rescue passes only when the full-frame result count is
# below this value. Higher = more aggressive rescue.
DETECTOR_MULTIPASS_TRIGGER_COUNT=4

# Rescue passes use a slightly lower confidence so weak objects
# can be recovered, then duplicate boxes are merged afterward.
DETECTOR_MULTIPASS_CONFIDENCE=0.05

# Number of overlapping long-axis crops. 2 is a good speed/recall
# balance; values above 4 are intentionally rejected by the app.
DETECTOR_MULTIPASS_SPLITS=2

# Fractional overlap between rescue crops.
DETECTOR_MULTIPASS_OVERLAP=0.25

# Ignore boxes that touch an artificial internal crop edge, because
# they are usually clipped duplicates. Neighboring crops overlap so
# the same object can still be detected whole.
DETECTOR_MULTIPASS_EDGE_MARGIN=0.015

# Merge duplicate boxes produced by full-frame and rescue passes.
DETECTOR_MERGE_IOU=0.50
DETECTOR_MERGE_CONTAINMENT=0.85


# Padding around each detected object before sending
# the crop into the classifier.
DETECTOR_CROP_PADDING=0.08


# Retry detector loading if checkpoint is missing/broken
DETECTOR_RETRY_SECONDS=10


# Automatically reload detector when best_detector.pt changes
DETECTOR_AUTO_RELOAD=true


# Check detector checkpoint changes every N seconds
DETECTOR_RELOAD_CHECK_SECONDS=2



# ============================================================
# CLASSIFIER UNCERTAINTY
# ============================================================

# Prediction is considered uncertain if top-1 confidence
# is below this value.
UNKNOWN_THRESHOLD=0.60


# Prediction is uncertain when top-1 and top-2 probabilities
# are too close.
UNCERTAINTY_MARGIN=0.10



# ============================================================
# OUT-OF-DISTRIBUTION DETECTION
# ============================================================

# Detect objects/images that are too different
# from the training dataset.
OOD_DETECTION_ENABLED=true


# Automatically generate OOD reference bank if unavailable
OOD_AUTO_BUILD=true


# OOD reference file
OOD_REFERENCE_PATH=models/ood_reference.npz


# Leave empty to use threshold stored inside NPZ
OOD_MIN_SIMILARITY=


# Detect disagreement between semantic embedding
# and classifier prediction.
OOD_CLASS_MISMATCH_ENABLED=true


OOD_CLASS_MISMATCH_MIN_SIMILARITY=0.60


OOD_CLASS_MISMATCH_MIN_GAP=0.08



# ============================================================
# MODEL LOADING / RECOVERY
# ============================================================

# Retry classifier loading after failure
MODEL_RETRY_SECONDS=10


# If GPU inference fails, temporarily use CPU.
# Try GPU again after this many seconds.
MODEL_DEVICE_RECOVERY_SECONDS=60


# Automatically reload classifier when checkpoint changes
MODEL_AUTO_RELOAD=true


# Check classifier checkpoint changes every N seconds
MODEL_RELOAD_CHECK_SECONDS=2



# ============================================================
# LEGACY FULL-FRAME RESCUE
# ============================================================

# /api/classify normally uses crops produced by YOLO.
#
# Keep disabled while testing multi-object detection.
FRAMING_RESCUE_ENABLED=false


FRAMING_RESCUE_MIN_CONFIDENCE=0.75



# ============================================================
# MODEL PRELOAD
# ============================================================

# Load/warm models shortly after server startup
PRELOAD_MODEL=true



# ============================================================
# IMAGE / MULTI-OBJECT PROCESSING
# ============================================================

# Maximum dimension of full image before detector processing.
#
# Increased from 1024 -> 1280 to retain more detail
# for multiple smaller objects.
CLASSIFIER_IMAGE_MAX_DIMENSION=1280


# Preserve more resolution in individual detector crops
CLASSIFIER_CROP_SOURCE_MAX_DIMENSION=1600


# Minimum short side of object before classification.
#
# Original: 160
# Previous: 80
#
# Reduced to 32 for diagnosing small-object detection.
CLASSIFIER_MIN_OBJECT_SHORT_SIDE=32


# Reject extremely large images to prevent memory problems
MAX_IMAGE_PIXELS=20000000



# ============================================================
# DATABASE
# ============================================================

DATABASE_PATH=data/waste_scanner.db


SQLITE_JOURNAL_MODE=DELETE


SQLITE_BUSY_TIMEOUT_MS=5000



# ============================================================
# LOCAL SERVER
# ============================================================

PORT=8000



# ============================================================
# HISTORY
# ============================================================

# Password required to delete scan history.
#
# Example:
# HISTORY_DELETE_PASSWORD=123456
HISTORY_DELETE_PASSWORD=


# ============================================================
# NGROK - OPTIONAL
# ============================================================

# Example:
NGROK_AUTHTOKEN=


# Custom ngrok domain if your ngrok account supports it
NGROK_DOMAIN=


# Optional HTTP Basic Auth for ngrok
NGROK_BASIC_AUTH=



# ============================================================
# FEEDBACK LEARNING
# ============================================================

# Allow user corrections/feedback to influence
# future classification results.
FEEDBACK_LEARNING_ENABLED=true


# Maximum feedback examples stored.
#
# Must be >= number of classes.
LEARNING_MAX_EXAMPLES=500


# Number of nearest feedback examples considered
LEARNING_TOP_K=5


# Minimum semantic similarity required before
# using feedback memory.
LEARNING_MIN_SIMILARITY=0.84


# Maximum influence feedback memory can have
LEARNING_MAX_WEIGHT=0.60


# Reduce influence when there is only one example
LEARNING_SINGLE_EXAMPLE_FACTOR=0.78



# ============================================================
# FEEDBACK CERTAINTY
# ============================================================

# Number of similar examples required before feedback
# can change an uncertain result into a certain result.
LEARNING_CERTAINTY_MIN_EXAMPLES=3


# Required agreement between feedback examples
LEARNING_CERTAINTY_MIN_AGREEMENT=0.75


# Required semantic similarity
LEARNING_CERTAINTY_MIN_SIMILARITY=0.92


# Embeddings above this similarity are considered duplicates
LEARNING_DUPLICATE_SIMILARITY=0.995



# ============================================================
# HISTORY THUMBNAILS
# ============================================================

SCAN_THUMBNAIL_DIR=data/scans


THUMBNAIL_MAX_DIMENSION=480


THUMBNAIL_JPEG_QUALITY=80



# ============================================================
# REAL-WORLD DATASET COLLECTION
# ============================================================

# Store real-world scans for future retraining
DATASET_COLLECTION_ENABLED=true


# Confirmed or corrected images are stored here
COLLECTED_DATA_DIR=data/collected


# Maximum dimension of collected images
COLLECTED_IMAGE_MAX_DIMENSION=1600


# JPEG quality of collected images
COLLECTED_JPEG_QUALITY=92


# Maximum uploaded image size
# 16 MB
MAX_COLLECTION_IMAGE_BYTES=16777216



# ============================================================
# TEMP / RUNTIME DIRECTORIES
# ============================================================

# Leave empty for automatic runtime directory selection
SMARTWASTE_RUNTIME_DIR=


# Temporary classifier dataset extraction directory
SMARTWASTE_DATASET_EXTRACT_DIR=


# Temporary YOLO detector dataset extraction directory
SMARTWASTE_DETECTOR_DATASET_EXTRACT_DIR=


# PyTorch cache directory
TORCH_HOME=